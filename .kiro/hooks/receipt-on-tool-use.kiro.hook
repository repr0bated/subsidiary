{
  "enabled": true,
  "name": "Receipt on tool use",
  "description": "Append a receipt (hash only) to the local hashchain after each tool use",
  "version": "1",
  "when": { "type": "postToolUse", "toolTypes": [".*"] },
  "then": { "type": "runCommand", "command": "bash .kiro/scripts/receipt.sh" }
}
