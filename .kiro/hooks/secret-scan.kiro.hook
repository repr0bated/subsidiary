{
  "enabled": true,
  "name": "Secret scan",
  "description": "Block writes that contain keys, tokens or env content",
  "version": "1",
  "when": { "type": "preToolUse", "toolTypes": ["write"] },
  "then": { "type": "askAgent", "prompt": "Before this write runs, inspect the content. If it contains a private key, mnemonic, API token, password, or the contents of .env or /etc/op-dbus/secrets, refuse the write and say what was found. Secrets come from the environment only." }
}
