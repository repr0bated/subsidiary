{
  "enabled": true,
  "name": "Svelte check",
  "description": "Keep the GUI type-clean",
  "version": "1",
  "when": {
    "type": "fileEdited",
    "patterns": [
      "ui/**/*.svelte"
    ]
  },
  "then": {
    "type": "runCommand",
    "command": "bash .kiro/scripts/toolchain.sh npm --prefix ui run check"
  }
}
