{
  "enabled": true,
  "name": "Contract tests",
  "description": "Tasks are not done with red tests",
  "version": "1",
  "when": {
    "type": "postTaskExecution"
  },
  "then": {
    "type": "runCommand",
    "command": "bash .kiro/scripts/toolchain.sh bash -c \"cd web3 && forge test -vv\""
  }
}
