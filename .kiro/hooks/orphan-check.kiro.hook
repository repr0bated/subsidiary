{
  "enabled": true,
  "name": "Orphan check",
  "description": "Find leftovers after a source file is deleted",
  "version": "1",
  "when": { "type": "fileDeleted", "patterns": ["web3/src/**", "web3/test/**", "web3/script/**"] },
  "then": { "type": "askAgent", "prompt": "A source file was deleted. Find remaining references to it in tests, scripts, specs, hooks and docs, and list them. Do not remove anything; report only." }
}
